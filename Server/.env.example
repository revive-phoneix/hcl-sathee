# Frontend URL used in invite emails
CLIENT_URL=https://hcl-sathee.vercel.app

# Backend
PORT=5000
JWT_SECRET=change_me

# Supabase — the real, primary database and file storage. Run
# Server/supabase/schema.sql once against a fresh project before setting
# these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sathee-uploads

# Web Push (VAPID) — replaces Firebase Cloud Messaging for browser push
# notifications. Generate a pair with: npx web-push generate-vapid-keys
# Public key is also needed on the Client as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (Gmail OAuth)
EMAIL_USER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=
