# Frontend URL used in invite emails
CLIENT_URL=https://hcl-sathee.vercel.app

# Backend
PORT=5000
JWT_SECRET=change_me

# Supabase (database + file storage) — fill these in once the project owner
# hands over credentials. Run Server/supabase/schema.sql in the Supabase SQL
# editor before starting the server against a fresh project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — defaults to "sathee-uploads" if unset (see Server/src/config/storage.js)
SUPABASE_STORAGE_BUCKET=sathee-uploads

# Firebase — kept ONLY for push notifications (FCM). Not required for the
# database or file storage anymore. Leave unset to run with push disabled.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json

# Email (Gmail OAuth)
EMAIL_USER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=
