# Frontend URL used in invite emails
CLIENT_URL=https://hcl-sathee.vercel.app

# Backend
PORT=5000
JWT_SECRET=change_me

# Firebase — the real, primary database and file storage right now.
FIREBASE_STORAGE_BUCKET=sathee-502704.firebasestorage.app
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json

# Supabase (migration mirror) — leave blank for now. Every Firestore write is
# also best-effort mirrored into Postgres once these are filled in with real
# values (see Server/supabase/schema.sql), so Supabase stays caught up while
# you finish testing it. Firebase remains the real source of truth until you
# explicitly cut over and remove it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Gmail OAuth)
EMAIL_USER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=
